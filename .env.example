# =============================================================================
# DaaS Intelligence Studio — конфігурація (префікс DAAS_)
# Скопіюйте у .env у корені репозиторію: cp .env.example .env
# =============================================================================

# --- LLM ---------------------------------------------------------------------
# Локальний OpenAI-сумісний сервер (Ollama / LM Studio / vLLM) — дефолт для екстракції.
DAAS_LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
DAAS_LLM_LOCAL_MODEL=readerlm-v2

# Хмарний провайдер (опційно). Працює з OpenAI, OpenRouter, Gemini-сумісними проксі.
# DAAS_LLM_BASE_URL=https://api.openai.com/v1
# DAAS_LLM_API_KEY=sk-...
# DAAS_LLM_MODEL=gpt-4o-mini

# Резервний провайдер на випадок відмови основного.
# DAAS_LLM_FALLBACK_BASE_URL=
# DAAS_LLM_FALLBACK_API_KEY=
# DAAS_LLM_FALLBACK_MODEL=

# Бюджет на один запуск (USD) + ліміт викликів + кеш + редагування PII для хмари.
DAAS_LLM_BUDGET_USD=0.75
DAAS_MAX_LLM_CALLS_PER_RUN=25
DAAS_LLM_CACHE=true
DAAS_LLM_REDACT_PII=true
DAAS_LLM_TEMPERATURE=0.0
DAAS_LLM_TIMEOUT_S=120

# Примусово: auto | openai_compat | mock | disabled
DAAS_LLM_PROVIDER=auto

# --- Краулінг ----------------------------------------------------------------
DAAS_FETCH_ENGINE=http          # http | playwright | auto
DAAS_RESPECT_ROBOTS=true
DAAS_USER_AGENT=DaasStudioBot/0.1 (+https://github.com/daas-intelligence-studio; polite research crawler)
DAAS_REQUEST_TIMEOUT_S=20
DAAS_MAX_RETRIES=2
DAAS_MAX_CONCURRENCY=4
DAAS_PER_DOMAIN_CONCURRENCY=1
DAAS_PER_DOMAIN_RPS=1.0
DAAS_CACHE_TTL_HOURS=24

# Дозволити приватні/loopback адреси (тільки для локальних демо/тестів!)
DAAS_ALLOW_PRIVATE_NETWORK=false

# --- Ліміти пайплайну --------------------------------------------------------
DAAS_SAMPLE_SIZE=4
DAAS_MAX_PAGES_PER_RUN=50
DAAS_MAX_DEPTH=1
DAAS_PRICE_DROP_THRESHOLD_PCT=5
DAAS_MAX_ENRICH_CONCURRENCY=3

# --- Discovery ---------------------------------------------------------------
# Self-hosted SearXNG з увімкненим JSON API (див. docker/searxng/settings.yml)
# DAAS_SEARXNG_URL=http://127.0.0.1:8080
DAAS_SEARCH_MAX_RESULTS=10

# --- Сервер і сховище --------------------------------------------------------
DAAS_HOST=127.0.0.1
DAAS_PORT=8000
DAAS_STORAGE_DIR=storage
DAAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Якщо не задано — токен генерується у storage/runtime.json і вбудовується в сторінку.
# DAAS_API_TOKEN=
# DAAS_DISABLE_AUTH=false

DAAS_OFFLINE=false
DAAS_LOG_LEVEL=INFO
